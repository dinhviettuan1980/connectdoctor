rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── helpers ────────────────────────────────────────────────────────────

    function isAuthed() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthed() && request.auth.uid == uid;
    }

    function isDoctor() {
      return isAuthed() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "doctor";
    }

    // Doctor has an active thread with this patient
    function doctorHasThreadWith(patientUid) {
      let threadId = patientUid + "_" + request.auth.uid;
      return exists(/databases/$(database)/documents/chatThreads/$(threadId));
    }

    // ─── /users/{uid} ────────────────────────────────────────────────────────
    // Users read their own doc; other authenticated users read display fields
    // (needed to show names in chat lists).

    match /users/{uid} {
      allow read: if isAuthed();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
    }

    // ─── /patientProfiles/{uid} ──────────────────────────────────────────────
    // Patient: full access to own profile.
    // Doctor: read-only if they share a chat thread with this patient.

    match /patientProfiles/{uid} {
      allow read, write: if isOwner(uid);
      allow read: if isDoctor() && doctorHasThreadWith(uid);
    }

    // ─── /medications/{id} ───────────────────────────────────────────────────
    // Docs carry patientUid field.

    match /medications/{id} {
      allow read, write: if isAuthed() &&
        (request.auth.uid == resource.data.patientUid ||
         (isDoctor() && doctorHasThreadWith(resource.data.patientUid)));
      allow create: if isAuthed() &&
        request.auth.uid == request.resource.data.patientUid;
    }

    // ─── /medicationSnapshots/{id} ───────────────────────────────────────────

    match /medicationSnapshots/{id} {
      allow read, write: if isAuthed() &&
        request.auth.uid == resource.data.patientUid;
      allow read: if isDoctor() &&
        doctorHasThreadWith(resource.data.patientUid);
      allow create: if isAuthed() &&
        request.auth.uid == request.resource.data.patientUid;
    }

    // ─── /metrics/{id} ───────────────────────────────────────────────────────

    match /metrics/{id} {
      allow read, write: if isAuthed() &&
        request.auth.uid == resource.data.patientUid;
      allow read: if isDoctor() &&
        doctorHasThreadWith(resource.data.patientUid);
      allow create: if isAuthed() &&
        request.auth.uid == request.resource.data.patientUid;
    }

    // ─── /doctorProfiles/{uid} ───────────────────────────────────────────────
    // Any authenticated user can read doctor profiles (needed for search/AI result).
    // Doctor can write own profile.

    match /doctorProfiles/{uid} {
      allow read: if isAuthed();
      allow write: if isOwner(uid);
    }

    // ─── /credentials/{id} ───────────────────────────────────────────────────

    match /credentials/{id} {
      allow read, write: if isAuthed() &&
        request.auth.uid == resource.data.doctorUid;
      allow create: if isAuthed() &&
        request.auth.uid == request.resource.data.doctorUid;
    }

    // ─── /chatThreads/{threadId} ─────────────────────────────────────────────
    // threadId = "{patientUid}_{doctorUid}" — deterministic.
    // Rules use resource.data fields (not doc-ID parsing) so Firestore can
    // statically prove list queries like where("patientUid","==",uid) are safe.

    match /chatThreads/{threadId} {
      allow read: if isAuthed() && (
        resource.data.patientUid == request.auth.uid ||
        resource.data.doctorUid == request.auth.uid
      );

      allow create: if isAuthed() && (
        request.auth.uid == request.resource.data.patientUid ||
        request.auth.uid == request.resource.data.doctorUid
      );

      allow update: if isAuthed() && (
        resource.data.patientUid == request.auth.uid ||
        resource.data.doctorUid == request.auth.uid
      );

      // ─── /chatThreads/{threadId}/messages/{msgId} ────────────────────────
      // threadId is a concrete value here (not a wildcard in the query), so
      // the split-based check is statically evaluable and safe for list queries.

      match /messages/{msgId} {
        allow read: if isAuthed() && (
          threadId.split("_")[0] == request.auth.uid ||
          threadId.split("_")[1] == request.auth.uid
        );
        allow create: if isAuthed() &&
          (threadId.split("_")[0] == request.auth.uid || threadId.split("_")[1] == request.auth.uid) &&
          request.auth.uid == request.resource.data.fromUid;
        allow update: if isAuthed() &&
          (threadId.split("_")[0] == request.auth.uid || threadId.split("_")[1] == request.auth.uid) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readAt"]);
      }
    }

    // ─── /prescriptions/{id} ─────────────────────────────────────────────────
    // Prescription photos (image URL + storage path). Patient-only access.

    match /prescriptions/{id} {
      allow read, write: if isAuthed() &&
        request.auth.uid == resource.data.patientUid;
      allow create: if isAuthed() &&
        request.auth.uid == request.resource.data.patientUid;
    }

    // ─── /aiSessions/{id} ────────────────────────────────────────────────────

    match /aiSessions/{id} {
      allow read, write: if isAuthed() &&
        request.auth.uid == resource.data.patientUid;
      allow create: if isAuthed() &&
        request.auth.uid == request.resource.data.patientUid;
    }
  }
}
