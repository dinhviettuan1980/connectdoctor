# Firebase Web app config (lấy từ Firebase Console → Project Settings)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Gemini API key (https://aistudio.google.com/app/apikey) — dùng cho OCR (lib/ocr.ts)
# Để trống thì app dùng mock data cho OCR.
EXPO_PUBLIC_GEMINI_API_KEY=

# Groq API key (https://console.groq.com/keys) — dùng cho AI triage (lib/ai.ts)
# Để trống thì app dùng mock data cho câu hỏi triage.
EXPO_PUBLIC_GROQ_API_KEY=
