# Which adapter to use: local | minio | firebase
STORAGE_ADAPTER=local
PORT=3001

# --- Local adapter ---
UPLOAD_DIR=./uploads
# URL this service is reachable at (for building public file URLs)
LOCAL_BASE_URL=http://localhost:3001/files

# --- MinIO adapter ---
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=connectdoctor
# Public URL for MinIO (same host/port if bucket is public)
MINIO_PUBLIC_URL=http://localhost:9000

# --- Firebase adapter (future) ---
# FIREBASE_SERVICE_ACCOUNT_KEY_PATH=./service-account.json
# FIREBASE_STORAGE_BUCKET=connectdoctor-8d202.firebasestorage.app
