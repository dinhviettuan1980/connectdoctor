rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Prescription photos — only the owning patient
    match /prescriptions/{patientUid}/{fileName} {
      allow read, write: if request.auth != null && request.auth.uid == patientUid;
    }

    // Profile photos, chat attachments etc. — any authenticated user
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
